<Layout title="Правила Vintage Hall" description="Правила платформи Vintage Hall: терміни, вимоги до продавців і покупців, відгуки, штрафні санкції, модерація та заборонені для продажу предмети.">
  <Header />
  <main class="mx-auto max-w-[1100px] px-4 py-12 sm:px-6 md:px-8 md:py-[60px]" id="main-content" tabindex="-1">
    <div class="mb-[22px] flex items-center gap-2.5 text-[0.875rem] uppercase tracking-[0.2em] text-brass"><span class="h-px w-8 bg-brass"></span> <span data-i18n="rules.eyebrow">Правила</span></div>
    <h1 class="mb-7 font-display text-[1.75rem] sm:text-[2.375rem]" data-i18n="rules.h1">Правила Vintage Hall</h1>

    <div class="rules-layout">
      <!-- Violity-style table of contents with the same anchor scheme -->
      <nav class="rules-toc" aria-label="Зміст правил">
        <a href="#terms">Терміни</a>
